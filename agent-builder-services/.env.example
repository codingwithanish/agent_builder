# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration
DB_TYPE=postgres
DB_URL=postgresql://postgres:postgres@localhost:5432/agent_builder
DB_POOL_MIN=2
DB_POOL_MAX=10

# External Services
LLM_SERVICE_URL=http://agent-builder-llm:5001
AWS_SERVICE_URL=http://agent-builder-aws:5002

# WebSocket Configuration
ENABLE_WEBSOCKETS=true

# Security
JWT_SECRET=your-secret-key-here
CORS_ORIGIN=http://localhost:5173

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=52428800

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60000

# Logging
LOG_LEVEL=debug
SERVICE_NAME=agent-builder-services

# AWS Configuration (for future use)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# OpenAI Configuration (for future use)
OPENAI_BASE_URL=https://api.openai.com/v1