# Server Configuration
PORT=5001
APP_MODE=real
SERVICE_NAME=agent-builder-llm-services
LOG_LEVEL=INFO

# Default LLM Provider
DEFAULT_LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Azure OpenAI
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=your_deployment_name

# AWS Bedrock
BEDROCK_REGION=us-east-1

# Model Allowlists (comma-separated)
ALLOWED_BEDROCK_MODELS=anthropic.claude-3-5-sonnet-20241022-v2:0,anthropic.claude-3-sonnet-20240229-v1:0
ALLOWED_OPENAI_MODELS=gpt-4o,gpt-4-turbo,gpt-3.5-turbo
ALLOWED_ANTHROPIC_MODELS=claude-3-5-sonnet-20241022,claude-3-sonnet-20240229
ALLOWED_AZURE_MODELS=gpt-4,gpt-35-turbo

# Request Limits
MAX_TOKENS_LIMIT=8192
MAX_MESSAGE_SIZE=32768
MAX_SCHEMA_SIZE=8192

# Timeouts (seconds)
REQUEST_TIMEOUT=300
PROVIDER_TIMEOUT=120

# CORS
CORS_ORIGINS=http://localhost:4000,http://localhost:3000

# Observability
ENABLE_METRICS=true
ENABLE_TRACING=false
METRICS_PORT=9090