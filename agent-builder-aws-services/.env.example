# Server Configuration
PORT=5002
HOST=0.0.0.0
NODE_ENV=development

# AWS Configuration
DEFAULT_AWS_REGION=us-east-1
S3_ARTIFACT_BUCKET=agent-builder-artifacts
ALLOW_HEADER_CREDS=true
ARTIFACT_MAX_MB=100
DEPLOY_TARGET=ecs

# AWS Credentials (optional - can use IAM roles or header-based)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# WebSocket Configuration
WS_ENABLED=true

# Logging
LOG_LEVEL=debug
SERVICE_NAME=agent-builder-aws-services

# Security
CORS_ORIGIN=http://localhost:4000

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60000

# Bedrock Configuration
BEDROCK_AGENT_ROLE_ARN=
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# ECS Configuration
ECS_CLUSTER_NAME=agent-builder-cluster
ECS_TASK_EXECUTION_ROLE_ARN=
ECS_TASK_ROLE_ARN=

# Lambda Configuration
LAMBDA_EXECUTION_ROLE_ARN=
LAMBDA_RUNTIME=nodejs18.x