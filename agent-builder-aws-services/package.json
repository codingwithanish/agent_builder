{
  "name": "agent-builder-aws-services",
  "version": "1.0.0",
  "description": "AWS integration microservice for Agent Builder platform",
  "main": "dist/app/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app/index.js",
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/app/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix"
  },
  "keywords": [
    "aws",
    "agent-builder",
    "bedrock",
    "s3",
    "ecs",
    "lambda",
    "typescript"
  ],
  "author": "Agent Builder Team",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.658.1",
    "@aws-sdk/client-bedrock-agent": "^3.658.1",
    "@aws-sdk/client-bedrock-agent-runtime": "^3.658.1",
    "@aws-sdk/client-bedrock-runtime": "^3.658.1",
    "@aws-sdk/client-ecs": "^3.658.1",
    "@aws-sdk/client-lambda": "^3.658.1",
    "@aws-sdk/client-s3": "^3.658.1",
    "@aws-sdk/client-sts": "^3.658.1",
    "@aws-sdk/lib-storage": "^3.658.1",
    "@aws-sdk/s3-request-presigner": "^3.913.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "mime-types": "^2.1.35",
    "multer": "^1.4.5-lts.1",
    "pino": "^8.16.2",
    "pino-pretty": "^10.2.3",
    "uuid": "^9.0.1",
    "ws": "^8.14.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/mime-types": "^2.1.4",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.5",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
