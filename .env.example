# Agent Builder Platform Environment Configuration

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=agent_builder
DB_USER=agent_builder
DB_PASSWORD=agent_builder_password

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Service URLs (for inter-service communication)
AWS_SERVICES_URL=http://agent-builder-aws-services:5002
LLM_SERVICES_URL=http://agent-builder-llm-services:5001

# Security
JWT_SECRET=your-super-secure-jwt-secret-key-change-this-in-production
SESSION_SECRET=your-super-secure-session-secret-change-this-in-production

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# AWS Configuration (for AWS services)
DEFAULT_AWS_REGION=us-east-1
S3_ARTIFACT_BUCKET=agent-builder-artifacts
ALLOW_HEADER_CREDS=true
WS_ENABLED=true
DEPLOY_TARGET=ecs

# LLM Services Configuration
LLM_APP_MODE=dummy  # Set to 'real' when you have API keys
DEFAULT_LLM_PROVIDER=openai
ENABLE_METRICS=true

# API Keys (fill these in when moving to 'real' mode)
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=your_deployment_name

# AWS Credentials (for AWS services - can also be provided via IAM roles)
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_SESSION_TOKEN=your_aws_session_token  # If using temporary credentials

# Logging
LOG_LEVEL=debug

# Development
NODE_ENV=development